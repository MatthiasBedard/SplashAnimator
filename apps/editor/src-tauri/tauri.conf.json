{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splash Animator",
  "version": "0.1.0",
  "identifier": "studio.splash.animator",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../.. build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Splash Animator",
        "decorations": false,
        "dragDropEnabled": false,
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "requireSignedVersion": true }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
